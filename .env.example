# Copy to .env and adjust. Never commit .env.

# ---------- shared ----------
# Password of the PostgreSQL user "autokarta". Use a long random value in production:
#   openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# ---------- local development (cargo run) ----------
DATABASE_URL=postgres://autokarta:change-me@localhost:5432/autokarta
# Plain HTTP on localhost; production always uses true.
COOKIE_SECURE=false
BIND_ADDR=127.0.0.1:8080
STATIC_DIR=../frontend/build
RUST_LOG=autokarta=debug,tower_http=info
# This computer's IP in the local network, for HTTPS testing from a phone
# (docker compose -f docker-compose.dev.yml --profile https up -d).
LAN_HOST=192.168.1.10

# ---------- production (docker compose up) ----------
# Image built by CI. Pin a version for predictable updates
# (ghcr.io/eretuk/autokarta:1.2.3 or :sha-abc1234).
AUTOKARTA_IMAGE=ghcr.io/eretuk/autokarta:latest
# Where the app container listens on the host; point your reverse proxy here.
# Keep 127.0.0.1 if the proxy runs on the same server; use the LAN address
# (e.g. 10.0.0.5:8080) only if the proxy is another machine in a trusted network.
APP_BIND=127.0.0.1:8080
# How many daily database backups to keep in ./backups.
BACKUP_KEEP_DAYS=14
# Time of the daily backup, HH:MM in UTC (the container clock).
BACKUP_TIME=03:30
