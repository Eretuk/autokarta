# Autokarta production settings for docker-compose.yml.
# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# For local development use .env.dev.example instead.

# ---------- application ----------
# The app version is set in docker-compose.yml, not here.
# Address and port on this server where the app listens (plain HTTP); point
# the reverse proxy here. 0.0.0.0 listens on every network interface. If the
# proxy is another machine, prefer this server's address in the network the
# proxy uses (e.g. 10.0.0.5:8080), and never expose the port to the internet:
# ports published by Docker bypass ufw/firewalld rules on the same host.
# If the proxy runs on this server outside Docker, use 127.0.0.1:8080.
APP_BIND=0.0.0.0:8080
# Optional. Reverse proxies whose X-Forwarded-For header is believed when
# logging the client address and limiting sign-in attempts per address.
# Comma-separated addresses or networks (203.0.113.7, 10.0.0.0/8);
# "private" (the default) means loopback and private networks, which covers
# a proxy on this server, in Docker or in a private network/VPC. If the
# proxy reaches this server over a public address, list that address here,
# otherwise every request looks as if it came from the proxy. Anyone else
# who reaches the port directly cannot fake their address.
#TRUSTED_PROXIES=private
# Optional. Twice a day the server asks GitHub whether a newer Autokarta
# release exists and tells the owner on the account page. The request
# carries only the app version. Set to false to never contact GitHub.
#UPDATE_CHECK=true

# ---------- storage ----------
# Host directory for the PostgreSQL files (<DATA_DIR>/db). Created on first
# start.
DATA_DIR=/opt/docker/autokarta

# ---------- database ----------
# Applied only when the database is created the first time (empty
# <DATA_DIR>/db); changing them later does not change an existing database.
POSTGRES_USER=autokarta
POSTGRES_DB=autokarta
# Required. Generate one: openssl rand -hex 32
POSTGRES_PASSWORD=

# ---------- backups ----------
# Not done by these containers: use your backup tool (DBackup or similar,
# pointed at the "db" service) or the cron example deploy/backup.sh.
# See README, "Backups".
