# Autokarta local development settings, for docker-compose.dev.yml and
# `cargo run`. Copy to .env in the repository root. Never commit .env.
# Production uses .env.example instead.

# ---------- database (docker-compose.dev.yml) ----------
# Data lives in ./.data/ (ignored by git); delete it to start from scratch.
POSTGRES_USER=autokarta
POSTGRES_DB=autokarta
POSTGRES_PASSWORD=change-me

# ---------- backend (cargo run) ----------
# Built from the values above (the backend and the shell both expand ${...}).
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
# Plain HTTP on localhost; production always uses true.
COOKIE_SECURE=false
BIND_ADDR=127.0.0.1:8080
STATIC_DIR=../frontend/build
RUST_LOG=autokarta=debug,tower_http=info

# ---------- HTTPS for phones (docker-compose.dev.yml --profile https) ----------
# This computer's address in the local network; open https://<LAN_HOST>:8443.
LAN_HOST=192.168.1.10
